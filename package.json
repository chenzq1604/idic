{
  "name": "idic",
  "version": "1.1.0",
  "description": "iDic - 智能词典",
  "main": "electron/main.js",
  "author": "iDic Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "pack:python": "python build_backend.py",
    "pack:frontend": "vite build",
    "pack:all": "vite build && python build_backend.py && electron-builder --win --publish never",
    "pack:electron": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.0",
    "element-plus": "^2.5.0",
    "markdown-it": "^14.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.idic.app",
    "productName": "iDic",
    "publish": null,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!**/__pycache__",
      "!**/*.pyc"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iDic"
    }
  }
}
